# Copy this file to .env and fill in the values. Never commit .env.

# --- Server ---
PORT=3001
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
# Where the SQLite database file lives (relative to the server/ folder)
DATABASE_PATH=./data/mahjong.db

# --- LLM (OpenCode Go, OpenAI-compatible chat completions API) ---
OPENCODE_API_KEY=
# Check https://opencode.ai/docs/go for the current base URL and model list.
# You can list models with:  curl -H "Authorization: Bearer $OPENCODE_API_KEY" $OPENCODE_BASE_URL/models
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=kimi-k2.6
